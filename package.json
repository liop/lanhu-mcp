{
  "name": "lanhu-mcp",
  "version": "1.1.0",
  "description": "MCP Server for Lanhu design prototypes - enables MCP clients to read Lanhu design data via Chrome extension bridge",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lanhu-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:extension": "node scripts/build-extension.js",
    "test:package": "npm run build && node --test test/package.test.mjs",
    "test:unit": "tsc -p tsconfig.test.json && node --test dist-test/test/regression.test.js",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist extension-dist",
    "package:extension": "npm run build:extension && node scripts/package-extension.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/server",
    "dist/shared",
    "dist/utils",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@types/chrome": "^0.0.260",
    "typescript": "^5.7.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "lanhu",
    "blue-lake",
    "design",
    "prototype",
    "chrome-extension",
    "claude",
    "ai"
  ],
  "license": "MIT"
}
